# Copy this file to .env and fill in the key for the provider you want to use.
# Never commit your .env file.

# Default provider for the CLI: claude | gemini | ollama | demo
DISCOVERY_PROVIDER=claude

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Google Gemini, free tier available (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: override the provider's default model
# DISCOVERY_MODEL=claude-sonnet-5-5

# Optional: Ollama server (local models)
# OLLAMA_HOST=http://localhost:11434
